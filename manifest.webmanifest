{
  "id": "downcount-app",
  "name": "Downcount — make every moment count",
  "short_name": "Downcount",
  "description": "Make, customize, share and embed live countdowns with custom themes and emojis.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f6f7fb",
  "theme_color": "#f6f7fb",
  "orientation": "any",
  "categories": ["productivity", "lifestyle", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Create a countdown", "short_name": "Create", "url": "./#/create", "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Theme Studio", "short_name": "Themes", "url": "./#/themes", "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Settings", "short_name": "Settings", "url": "./#/settings", "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192" }] }
  ]
}
